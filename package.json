{
  "name": "pixel-go",
  "version": "0.5.43",
  "private": true,
  "engines": {
    "node": ">=18 <23"
  },
  "scripts": {
    "predev": "node tools/fix-esbuild-perms.mjs && node tools/check-legacy-hooks.mjs",
    "prebuild": "node tools/fix-esbuild-perms.mjs && node tools/check-legacy-hooks.mjs",
    "prepreview": "node tools/fix-esbuild-perms.mjs && node tools/check-legacy-hooks.mjs",
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5175 --strictPort",
    "server": "node server/index.mjs",
    "dev:lan": "concurrently -n server,client -c green,cyan \"npm run server\" \"npm run dev\"",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "check:legacy-hooks": "node tools/check-legacy-hooks.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^4.5.5"
  },
  "optionalDependencies": {
    "canvas": "^3.2.1"
  }
}
